<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tabariyya</groupId>
    <artifactId>spring-authentication</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <name>spring-authentication</name>
    <description>Authentication library supporting local and LDAP strategies with JWT</description>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Waleed</id>
            <name>Waleed Shanaa</name>
            <email>waleed.shanaa@tabariyya.com</email>
        </developer>
    </developers>

    <url>https://github.com/tabariyya/spring-authentication.git</url>

    <scm>
        <url>https://github.com/tabariyya/spring-authentication</url>
        <connection>scm:git:git://github.com/tabariyya/spring-authentication.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:tabariyya/spring-authentication.git</developerConnection>
    </scm>

    <dependencies>

        <dependency>
            <groupId>com.tabariyya</groupId>
            <artifactId>utils</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Spring Web: ResponseEntity, HttpStatus, ResponseStatusException, @Value -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>5.3.39</version>
        </dependency>

        <!-- Spring Security Crypto: PasswordEncoder -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
            <version>5.7.12</version>
        </dependency>

        <!-- Bean Validation API: @NotBlank, @Size, @Pattern -->
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
            <version>2.0.1.Final</version>
        </dependency>

    </dependencies>

</project>
